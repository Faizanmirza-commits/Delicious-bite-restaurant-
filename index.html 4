<style>
  :root{
    --red:#D32F2F;
    --red-dark:#a02323;
    --gold:#FFB300;
    --gold-dark:#c98600;
    --ink:#241412;
    --cream:#FFF8ED;
    --card:#ffffff;
    --shadow:0 10px 30px rgba(36,20,18,.12);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter',sans-serif;
    background:var(--cream);
    color:var(--ink);
    overflow-x:hidden;
  }
  h1,h2,h3,.brand{font-family:'Poppins',sans-serif;}
  a{text-decoration:none;color:inherit;}
  img{max-width:100%;display:block;}
  button{font-family:'Poppins',sans-serif;cursor:pointer;border:none;}

  /* ---------- Nav ---------- */
  .navbar{
    position:fixed;top:0;left:0;right:0;z-index:100;
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 6%;
    background:rgba(36,20,18,.0);
    transition:.35s;
  }
  .navbar.scrolled{
    background:rgba(255,248,237,.95);
    backdrop-filter:blur(8px);
    box-shadow:0 2px 20px rgba(0,0,0,.08);
  }
  .navbar .brand{
    font-weight:800;font-size:1.4rem;color:#fff;letter-spacing:.5px;
    transition:.35s;
  }
  .navbar.scrolled .brand{color:var(--red);}
  .navbar .brand span{color:var(--gold);}
  .nav-links{display:flex;gap:28px;font-weight:500;}
  .nav-links a{color:#fff;font-size:.95rem;transition:.3s;}
  .navbar.scrolled .nav-links a{color:var(--ink);}
  .nav-links a:hover{color:var(--gold);}
  .nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;}
  .nav-toggle span{width:26px;height:3px;background:#fff;border-radius:3px;transition:.3s;}
  .navbar.scrolled .nav-toggle span{background:var(--red);}

  /* ---------- Hero ---------- */
  .hero{
    position:relative;
    min-height:100vh;
    display:flex;align-items:center;justify-content:center;
    text-align:center;
    background:
      linear-gradient(180deg, rgba(20,10,8,.55), rgba(20,10,8,.75)),
      url('https://images.unsplash.com/photo-1600891964599-f61ba0e24092?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
  }
  .hero::after{
    content:"";
    position:absolute;inset:0;
    background:repeating-linear-gradient(135deg, rgba(255,179,0,.05) 0 2px, transparent 2px 40px);
    pointer-events:none;
  }
  .hero-content{position:relative;z-index:2;padding:0 20px;max-width:780px;}
  .eyebrow{
    display:inline-block;color:var(--gold);
    font-weight:600;letter-spacing:3px;font-size:.8rem;
    text-transform:uppercase;margin-bottom:18px;
    border:1px solid rgba(255,179,0,.5);padding:6px 18px;border-radius:30px;
  }
  .hero h1{
    font-size:clamp(2.6rem,7vw,5rem);
    font-weight:900;color:#fff;line-height:1.05;
    text-shadow:0 4px 20px rgba(0,0,0,.35);
  }
  .hero h1 span{color:var(--gold);}
  .hero .tagline{
    font-size:clamp(1.1rem,2.5vw,1.5rem);
    color:#fff;font-weight:500;margin-top:16px;
  }
  .hero .subtagline{
    font-size:1rem;color:var(--gold);font-weight:600;margin-top:8px;
    letter-spacing:.5px;
  }
  .btn{
    display:inline-block;padding:15px 38px;border-radius:50px;
    font-weight:700;font-size:1rem;transition:.3s;
  }
  .btn-primary{
    background:linear-gradient(135deg,var(--gold),var(--gold-dark));
    color:var(--ink);box-shadow:0 8px 24px rgba(255,179,0,.35);
  }
  .btn-primary:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(255,179,0,.5);}
  .hero-cta{margin-top:36px;}

  /* ---------- Section wrapper ---------- */
  section{padding:100px 6%;}
  .section-head{text-align:center;max-width:680px;margin:0 auto 55px;}
  .section-head .eyebrow-line{
    display:flex;align-items:center;gap:12px;justify-content:center;margin-bottom:14px;
  }
  .section-head .eyebrow-line span.dash{width:36px;height:3px;background:var(--gold);border-radius:3px;}
  .section-head .eyebrow-line span.txt{color:var(--red);font-weight:700;letter-spacing:2px;font-size:.8rem;text-transform:uppercase;}
  .section-head h2{font-size:clamp(2rem,4vw,2.8rem);font-weight:800;color:var(--ink);}
  .section-head p{margin-top:16px;font-size:1.05rem;color:#5c4a45;line-height:1.7;}

  /* ---------- About ---------- */
  .about{background:var(--card);}
  .about-wrap{
    max-width:900px;margin:0 auto;text-align:center;
    background:linear-gradient(135deg,#fff, #fff8ec);
    border:1px solid #f1e3c8;
    border-radius:24px;padding:60px 40px;box-shadow:var(--shadow);
    position:relative;
  }
  .about-wrap::before{
    content:"🌶";
    position:absolute;top:-26px;left:50%;transform:translateX(-50%);
    background:var(--red);color:#fff;width:52px;height:52px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;font-size:1.4rem;
    box-shadow:0 8px 20px rgba(211,47,47,.4);
  }
  .about-wrap h2{font-size:clamp(1.8rem,3.5vw,2.4rem);font-weight:800;color:var(--red);margin-bottom:18px;}
  .about-wrap p{font-size:1.1rem;line-height:1.85;color:#4a3934;}
  .about-stats{display:flex;justify-content:center;gap:50px;margin-top:36px;flex-wrap:wrap;}
  .about-stats div{text-align:center;}
  .about-stats h3{color:var(--gold-dark);font-size:1.8rem;font-weight:800;}
  .about-stats p{font-size:.85rem;color:#7a6a64;margin:0;}

  /* ---------- Menu ---------- */
  .menu{background:var(--cream);}

  /* Admin */
  .admin-box{
    max-width:420px;margin:0 auto 50px;background:var(--card);
    border:2px dashed var(--gold);border-radius:16px;padding:24px;text-align:center;
  }
  .admin-box h4{font-size:.95rem;color:var(--red);font-weight:700;margin-bottom:12px;letter-spacing:.5px;text-transform:uppercase;}
  .admin-box input{
    width:100%;padding:12px 14px;border-radius:10px;border:1px solid #e0d3c0;
    margin-bottom:12px;font-size:1rem;font-family:'Inter',sans-serif;
  }
  .admin-box input:focus{outline:2px solid var(--gold);}
  .admin-login-btn{
    background:var(--red);color:#fff;padding:11px 26px;border-radius:10px;font-weight:600;font-size:.9rem;transition:.25s;
  }
  .admin-login-btn:hover{background:var(--red-dark);}
  .admin-msg{font-size:.85rem;margin-top:10px;min-height:18px;font-weight:600;}
  .admin-msg.error{color:var(--red);}
  .admin-msg.ok{color:#2e7d32;}

  .admin-panel{
    max-width:900px;margin:0 auto 55px;background:#2a1512;color:#fff;
    border-radius:18px;padding:28px 30px;box-shadow:var(--shadow);
    display:none;
  }
  .admin-panel.show{display:block;}
  .admin-panel-head{
    display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:10px;
  }
  .admin-panel-head h4{color:var(--gold);font-size:1.1rem;letter-spacing:.5px;}
  .logout-btn{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.3)!important;padding:8px 16px;border-radius:8px;font-size:.85rem;}
  .logout-btn:hover{border-color:var(--gold)!important;color:var(--gold);}
  .admin-row{
    display:flex;justify-content:space-between;align-items:center;
    padding:14px 0;border-bottom:1px solid rgba(255,255,255,.1);
    flex-wrap:wrap;gap:10px;
  }
  .admin-row:last-child{border-bottom:none;}
  .admin-row .item-name{font-weight:600;}
  .admin-row .item-name small{display:block;color:var(--gold);font-weight:400;font-size:.8rem;}
  .toggle-btn{
    padding:9px 18px;border-radius:8px;font-size:.85rem;font-weight:600;color:#fff;
    background:#2e7d32;transition:.25s;
  }
  .toggle-btn.out{background:var(--red);}
  .toggle-btn:hover{filter:brightness(1.1);}

  .menu-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:34px;max-width:1200px;margin:0 auto;
  }
  .food-card{
    background:var(--card);border-radius:20px;overflow:hidden;box-shadow:var(--shadow);
    position:relative;transition:.35s;border:1px solid #f2e6d2;
  }
  .food-card:hover{transform:translateY(-8px);box-shadow:0 18px 40px rgba(36,20,18,.18);}
  .food-img-wrap{position:relative;height:210px;overflow:hidden;}
  .food-img-wrap img{width:100%;height:100%;object-fit:cover;transition:.5s;}
  .food-card:hover .food-img-wrap img{transform:scale(1.08);}
  .food-img-wrap.faded img{filter:grayscale(70%) brightness(.6);}
  .stock-badge{
    position:absolute;top:12px;right:12px;background:var(--red);color:#fff;
    font-size:.7rem;font-weight:800;letter-spacing:.5px;padding:6px 12px;border-radius:20px;
    box-shadow:0 4px 10px rgba(0,0,0,.3);
  }
  .food-body{padding:22px 22px 26px;}
  .food-body h3{font-size:1.25rem;font-weight:700;color:var(--ink);}
  .food-price{color:var(--gold-dark);font-weight:800;font-size:1.15rem;margin:8px 0 18px;}
  .order-btn{
    width:100%;padding:13px;border-radius:10px;font-weight:700;font-size:.95rem;
    background:var(--red);color:#fff;transition:.25s;
    display:flex;align-items:center;justify-content:center;gap:8px;
  }
  .order-btn:hover{background:var(--red-dark);}
  .order-btn:disabled{background:#c9c0ba;color:#7a716c;cursor:not-allowed;}

  /* ---------- Footer ---------- */
  footer{
    background:var(--ink);color:#f3e8de;padding:70px 6% 30px;
  }
  .footer-grid{
    display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:50px;max-width:1200px;margin:0 auto;
  }
  .footer-brand h3{color:var(--gold);font-size:1.5rem;font-weight:800;margin-bottom:14px;}
  .footer-brand p{color:#cbb9ae;line-height:1.7;font-size:.95rem;}
  footer h4{color:#fff;font-size:1rem;margin-bottom:18px;letter-spacing:.5px;text-transform:uppercase;}
  footer .addr{color:#cbb9ae;line-height:1.8;font-size:.95rem;margin-bottom:16px;}
  .wa-btn{
    display:inline-flex;align-items:center;gap:10px;background:#25D366;color:#fff;
    padding:12px 22px;border-radius:40px;font-weight:700;font-size:.9rem;transition:.25s;
  }
  .wa-btn:hover{background:#1ebe57;}
  .social-row{display:flex;gap:14px;margin-top:20px;}
  .social-row a{
    width:44px;height:44px;border-radius:50%;background:rgba(255,179,0,.12);
    display:flex;align-items:center;justify-content:center;color:var(--gold);
    font-size:1.1rem;transition:.25s;border:1px solid rgba(255,179,0,.25);
  }
  .social-row a:hover{background:var(--gold);color:var(--ink);}
  .delivery-note{
    text-align:center;color:var(--gold);font-weight:700;margin:50px 0 20px;font-size:1rem;
    letter-spacing:.3px;
  }
  .copyright{
    text-align:center;color:#8a7a72;font-size:.85rem;border-top:1px solid rgba(255,255,255,.08);
    padding-top:22px;
  }

  /* ---------- Floating WhatsApp ---------- */
  .float-wa{
    position:fixed;bottom:26px;right:26px;z-index:200;
    width:62px;height:62px;border-radius:50%;background:#25D366;
    display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.8rem;
    box-shadow:0 10px 26px rgba(0,0,0,.3);
    animation:pulse 2.2s infinite;
  }
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(37,211,102,.5);}
    70%{box-shadow:0 0 0 16px rgba(37,211,102,0);}
    100%{box-shadow:0 0 0 0 rgba(37,211,102,0);}
  }

  /* ---------- Responsive ---------- */
  @media (max-width:900px){
    .menu-grid{grid-template-columns:repeat(2,1fr);}
    .footer-grid{grid-template-columns:1fr 1fr;}
    .footer-brand{grid-column:1/-1;}
  }
  @media (max-width:680px){
    .nav-links{
      position:absolute;top:100%;left:0;right:0;background:var(--cream);
      flex-direction:column;padding:20px 6%;gap:0;
      box-shadow:0 10px 20px rgba(0,0,0,.1);
      display:none;
    }
    .nav-links.open{display:flex;}
    .nav-links a{color:var(--ink);padding:12px 0;border-bottom:1px solid #eee;}
    .nav-toggle{display:flex;}
    .menu-grid{grid-template-columns:1fr;}
    .footer-grid{grid-template-columns:1fr;text-align:center;}
    .social-row{justify-content:center;}
    section{padding:70px 6%;}
    .about-stats{gap:30px;}
  }
</style>
</head>
