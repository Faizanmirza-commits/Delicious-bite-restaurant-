<script>
document.getElementById('year').textContent = new Date().getFullYear();

/* ---------------- MENU DATA ---------------- */
const menuItems = [
  { id:'falooda', name:'Falooda', price:150, img:'data:image/jpeg;base64,' },
  { id:'biryani', name:'Biryani', price:350, img:'data:image/jpeg;base64,' },
  { id:'pizza',   name:'Pizza',   price:1400, img:'data:image/jpeg;base64,' },
  { id:'burger',  name:'Burger',  price:170, img:'data:image/jpeg;base64,' },
  { id:'rabri',   name:'Rabri',   price:200, img:'data:image/jpeg;base64,' },
];

const WHATSAPP_NUMBER = '923106396034';
const STOCK_KEY = 'db_stock_status';
const ADMIN_KEY = 'db_admin_logged_in';
const ADMIN_PASSWORD = '12788312';

/* ---------------- STOCK STATE ---------------- */
function loadStock(){
  const saved = localStorage.getItem(STOCK_KEY);
  if(saved){
    try{ return JSON.parse(saved); }catch(e){}
  }
  const fresh = {};
  menuItems.forEach(i => fresh[i.id] = true); // true = in stock
  localStorage.setItem(STOCK_KEY, JSON.stringify(fresh));
  return fresh;
}
let stockStatus = loadStock();

function saveStock(){
  localStorage.setItem(STOCK_KEY, JSON.stringify(stockStatus));
}

/* ---------------- WHATSAPP ORDER ---------------- */
function orderViaWhatsapp(name, price){
  const message = `Hello I want to order ${name} for Rs. ${price} from Delicious Bites Pakpattan`;
  const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
  window.open(url, '_blank');
}

function handleOrderClick(item){
  if(!stockStatus[item.id]) return; // out of stock guard

  // Meta Pixel: AddToCart
  if(typeof fbq !== 'undefined'){
    fbq('track', 'AddToCart', { content_name: item.name, value: item.price, currency: 'PKR' });
    fbq('track', 'InitiateCheckout', { content_name: item.name, value: item.price, currency: 'PKR' });
  }

  orderViaWhatsapp(item.name, item.price);
}

/* ---------------- RENDER MENU ---------------- */
function renderMenu(){
  const grid = document.getElementById('menuGrid');
  grid.innerHTML = '';
  menuItems.forEach(item => {
    const inStock = stockStatus[item.id];
    const card = document.createElement('div');
    card.className = 'food-card';
    card.innerHTML = `
      <div class="food-img-wrap ${inStock ? '' : 'faded'}">
        <img src="${item.img}" alt="${item.name}">
        ${inStock ? '' : '<span class="stock-badge">OUT OF STOCK</span>'}
      </div>
      <div class="food-body">
        <h3>${item.name}</h3>
        <p class="food-price">Rs. ${item.price}</p>
        <button class="order-btn" data-id="${item.id}" ${inStock ? '' : 'disabled'}>
          🛵 Order Now
        </button>
      </div>
    `;
    grid.appendChild(card);
  });

  grid.querySelectorAll('.order-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = menuItems.find(i => i.id === btn.dataset.id);
      handleOrderClick(item);
    });
  });
}
renderMenu();

/* ---------------- ADMIN PANEL ---------------- */
const adminBox = document.getElementById('adminBox');
const adminPanel = document.getElementById('adminPanel');
const adminMsg = document.getElementById('adminMsg');
const adminItemsList = document.getElementById('adminItemsList');

function renderAdminList(){
  adminItemsList.innerHTML = '';
  menuItems.forEach(item => {
    const inStock = stockStatus[item.id];
    const row = document.createElement('div');
    row.className = 'admin-row';
    row.innerHTML = `
      <div class="item-name">${item.name}<small>Rs. ${item.price}</small></div>
      <button class="toggle-btn ${inStock ? '' : 'out'}" data-id="${item.id}">
        ${inStock ? 'Mark Out of Stock' : 'Mark In Stock'}
      </button>
    `;
    adminItemsList.appendChild(row);
  });

  adminItemsList.querySelectorAll('.toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      stockStatus[id] = !stockStatus[id];
      saveStock();
      renderAdminList();
      renderMenu();
    });
  });
}

function showAdminPanel(){
  adminBox.style.display = 'none';
  adminPanel.classList.add('show');
  renderAdminList();
}

function hideAdminPanel(){
  localStorage.removeItem(ADMIN_KEY);
  adminPanel.classList.remove('show');
  adminBox.style.display = 'block';
  document.getElementById('adminPassword').value = '';
  adminMsg.textContent = '';
}

// Restore login state on refresh
if(localStorage.getItem(ADMIN_KEY) === 'true'){
  showAdminPanel();
}

document.getElementById('adminLoginBtn').addEventListener('click', () => {
  const entered = document.getElementById('adminPassword').value;
  if(entered === ADMIN_PASSWORD){
    localStorage.setItem(ADMIN_KEY, 'true');
    adminMsg.textContent = '';
    showAdminPanel();
  } else {
    adminMsg.textContent = 'Incorrect password. Try again.';
    adminMsg.className = 'admin-msg error';
  }
});

document.getElementById('adminPassword').addEventListener('keypress', (e) => {
  if(e.key === 'Enter') document.getElementById('adminLoginBtn').click();
});

document.getElementById('logoutBtn').addEventListener('click', hideAdminPanel);

/* ---------------- NAVBAR SCROLL + MOBILE TOGGLE ---------------- */
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 60);
});
const navToggle = document.getElementById('navToggle');
const navLinks = document.getElementById('navLinks');
navToggle.addEventListener('click', () => navLinks.classList.toggle('open'));
navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));

/* ---------------- META PIXEL: HERO ORDER NOW -> Lead ---------------- */
document.getElementById('heroOrderBtn').addEventListener('click', () => {
  if(typeof fbq !== 'undefined') fbq('track', 'Lead');
});

/* ---------------- META PIXEL: ViewContent on scroll to menu ---------------- */
let viewContentFired = false;
const menuSection = document.getElementById('menu');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if(entry.isIntersecting && !viewContentFired){
      viewContentFired = true;
      if(typeof fbq !== 'undefined') fbq('track', 'ViewContent');
    }
  });
}, { threshold: 0.3 });
observer.observe(menuSection);

